{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/Titans", "destination": "/titans", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:file.:ext(jpg|jpeg|png|webp|gif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}